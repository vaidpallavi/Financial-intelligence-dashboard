# Copy this file to .env and fill in your real values.
# .env is git-ignored - it will NEVER be pushed to GitHub. Only .env.example is.

# Required - your Anthropic API key. Get one at https://console.anthropic.com
# This key stays on the SERVER ONLY. The browser never sees it.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which Claude model the agents use.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Access control (this is what keeps your API bill safe) ---

# The password anyone needs to type in to reach the dashboard at all.
# Only share this with people you want to be able to use/click the site
# (e.g. an interviewer). Pick something you don't reuse elsewhere.
SITE_PASSWORD=change-me-to-something-only-you-know

# A long random secret used to sign login session cookies. NOT the same as
# your password - this never needs to be typed by anyone, it just needs to
# be long and random. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Hard cap on how many Claude (agent) calls the whole site can make per day,
# across ALL visitors combined. Once hit, agent buttons return a friendly
# "daily limit reached" message instead of calling the API, so you can never
# get an unexpected bill even if someone hammers the buttons. Resets daily
# at UTC midnight. Tune this to whatever you're comfortable spending on.
DAILY_CLAUDE_CALL_LIMIT=50

# Optional - only needed if you want news beyond the free RSS feeds already wired in.
NEWSAPI_KEY=

# Port the server runs on locally. Render/Railway/etc override this automatically in production.
PORT=3001

# Comma-separated list of origins allowed to call this API in production.
ALLOWED_ORIGINS=http://localhost:3001
